{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "fable",
  "advisorModel": "fable",
  "effortLevel": "high",
  "autoCompactEnabled": true,
  "awaySummaryEnabled": true,
  "cleanupPeriodDays": 45,
  "statusLine": {
    "type": "command",
    "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/statusline.py",
    "padding": 1,
    "refreshInterval": 10
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(ls:*)",
      "Bash(./scripts/gitnexus-graph.sh status)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/gitnexus-graph.sh status 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "superpowers@superpowers-dev": true
  }
}
